# Backend API adresi (Better Auth /api/auth/* buradan mount edilir).
#
# DOLU ise: istemciler bu adrese MUTLAK URL ile gider (local gelistirme yolu;
#   vite.config.ts'teki /api proxy'si fiilen devreye girmez).
# BOS birakilirsa: istekler goreli /api/... yoluna gider ve vite proxy'si
#   backend'e yollar - tek origin gerektiren tunel/deploy senaryosu icin.
VITE_API_URL=http://localhost:3000

# Google One Tap (auth-client.ts, components/auth/google-one-tap.tsx).
# Backend'deki (root .env) GOOGLE_CLIENT_ID ile AYNI degeri kullanin - client ID
# Google tarafinda kamuya acik kabul edilir, tarayiciya gitmesi sorun degildir.
VITE_GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
