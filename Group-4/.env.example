# PostgreSQL (Docker local: docker-compose.yml). Production: managed Postgres (Neon/Supabase/Railway/RDS) - sadece DATABASE_URL degisir.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mock_interview?schema=public"

# Better Auth
BETTER_AUTH_SECRET="degistir-en-az-32-karakter-rastgele-sir"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare quick tunnel (npm run tunnel) ile calisirken "true" yapin: Host
# *.trycloudflare.com ise baseURL istekten cozulur, boylece rastgele tunel
# adresi icin .env duzenlemek gerekmez.
# URETIMDE ASLA "true" OLMAMALIDIR (bkz. docs/SECURITY.md S1): joker host,
# Host basligi uzerinden sifirlama/dogrulama baglantisinin saldirganin alan
# adina yonlendirilmesine ve hesap ele gecirmeye izin verir.
ALLOW_TUNNEL_HOSTS="false"

# Google OAuth (Hikaye 3) - zorunlu (env.validation.ts basta hata verir).
# Gercek Google Cloud OAuth istemcisi kaydedilene kadar bu yer tutuculari
# kullanabilirsiniz; uygulama acilir ama tarayicida Google girisi calismaz.
# Not: Google One Tap icin frontend/.env.example'daki VITE_GOOGLE_CLIENT_ID
# bu degerle AYNI olmalidir.
GOOGLE_CLIENT_ID="test-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="test-client-secret-placeholder"

# Admin seed (FR-018) - yalnizca seed/migration ile kullanilir, uygulama ici kayit yok
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="DegistirilecekGucluSifre1"

# Frontend origin (CORS / redirect)
FRONTEND_URL="http://localhost:5173"

# Oturum cerezinin sameSite duruşu (bkz. docs/SECURITY.md S5).
#   lax    -> tek origin / ayni site deploy (varsayilan)
#   none   -> frontend AYRI bir alan adindaysa zorunlu; Secure otomatik acilir
#             ve cerez yalnizca HTTPS uzerinden gider
# State degistiren uclar ayrica OriginGuard ile korunur, yani bu deger
# gevsetilse bile CSRF savunmasi ayakta kalir.
COOKIE_SAMESITE="lax"

# Onundeki guvenilen ters vekil sayisi (Render/Fly/nginx tipik olarak 1).
# 0 = kapali. IP bazli siklik siniri dogru istemci IP'sini bununla bulur;
# yanlis degerde X-Forwarded-For sahtelenerek sinir atlatilabilir.
# UYARI: NODE_ENV=production iken bu satir ACIKCA yazilmalidir (yoksa uygulama
# acilmaz). Vekil yoksa "0" yazmak gecerli bir cevaptir; istenen tek sey
# kararin varsayilana birakilmamasidir - bkz. docs/SECURITY.md S11.
TRUST_PROXY="0"

# Admin istatistik (/api/admin/stats) onbellek suresi (ms). Sorgular pahalidir
# (iki tanesi satirlari cekip uygulama katmaninda toplar) ve panel her acilista
# ayni hesabi tekrarlar. 0 = onbellek kapali (entegrasyon testleri boyle kosar).
ADMIN_STATS_CACHE_TTL_MS="30000"

# Cekilen LinkedIn ilan metninin onbellek suresi (ms). Ayni ilan icin tekrar
# tekrar dis istek yapilmaz; yalnizca BASARILI cekimler tutulur.
# 0 = onbellek kapali (entegrasyon testleri boyle kosar).
LINKEDIN_JOB_CACHE_TTL_MS="3600000"

# Mail gonderim yolu (ADR-0008: Resend) - gelistirmede console yeterli (mail hesabi gerekmez).
# Production: MAIL_TRANSPORT="resend" + RESEND_API_KEY (resend.com, ucretsiz katman).
MAIL_TRANSPORT="console"
MAIL_FROM="onboarding@resend.dev"
RESEND_API_KEY=""

# CAPTCHA (opsiyonel, FR-017 throttling icin)
CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# Sunucu portu (main.ts process.env.PORT ?? 3000)
PORT=3000

# ---------------------------------------------------------------------------
# LLM (002-interview ve sonrasi) - ADR-0007: Groq birincil + DeepSeek yedek.
# Her ikisi de OpenAI-uyumlu API sunar, tek `openai` npm SDK yeterlidir;
# saglayici degisimi yalnizca LLM_BASE_URL + LLM_API_KEY + LLM_MODEL degisikligidir.
# ---------------------------------------------------------------------------
LLM_PROVIDER="groq"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_API_KEY=""

# T001 spike karari: Groq'ta `strict: true` (constrained decoding) YALNIZCA
# openai/gpt-oss-20b ve openai/gpt-oss-120b modellerinde desteklenir.
# Secilen: gpt-oss-120b (Turkce kalitesi dogrulandi). Ikincil aday: gpt-oss-20b.
# DeepSeek yedek yolunda `strict` YOKTUR - tek garanti katman-2 Zod dogrulamasidir.
LLM_MODEL="openai/gpt-oss-120b"

# YEDEK saglayici (opsiyonel) - ADR-0007 R1. Birincil saglayici cevap
# veremezse (kota doldu, 5xx, ag hatasi, timeout) ayni cagri BIR kez burada
# tekrarlanir. Operasyon ayrimi YOKTUR. Bos birakilirsa yedek yol kapalidir ve
# birincil dustugunde kullanici hata gorur.
# Sema hatasinda yedege GECILMEZ: saglayici ayakta, yalnizca yanit bozuk -
# ikinci saglayici da ayni veriyle ayni hatayi uretebilir (API_CONVENTIONS 3.4).
# YA DORDU BIRDEN YA HICBIRI - yarim yapilandirma acilista hata verir
# (env.validation.ts), cunku sessizce devre disi kalmasi teshis edilemez olurdu.
# LLM_ALT_PROVIDER="deepseek"
# LLM_ALT_BASE_URL="https://api.deepseek.com"
# LLM_ALT_API_KEY=""
# `deepseek-chat` / `deepseek-reasoner` takma adlari 2026-07-24'te kaldirildi;
# guncel model adlari deepseek-v4-flash ve deepseek-v4-pro.
# LLM_ALT_MODEL="deepseek-v4-flash"

# Varsayilan LLM cagri zaman asimi (ms). Gorusme raporu cagrisi kod icinde
# 60000 ile override eder (SC-005) - bkz. docs/API_CONVENTIONS.md 3.2
LLM_REQUEST_TIMEOUT_MS="30000"

# PDF is ilani yukleme ust siniri (MB) - FR-002
PDF_MAX_SIZE_MB="10"

# NOT: VOICE_* degiskeni YOKTUR. Sozlu mod tarayici Web Speech API ile calisir
# (ADR-0010); sunucu tarafinda ses isleme ve saglayici anahtari gerekmez.
